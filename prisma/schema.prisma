generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STORE_ADMIN
  SUPER_ADMIN
}

enum PetType {
  DOG
  CAT
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model Store {
  galleryImages StoreGalleryImage[]
  website Json?
  banners StoreBanner[]
  id          String            @id @default(cuid())
  name        String            @db.VarChar(160)
  slug        String            @unique @db.VarChar(100)
  description String            @db.Text
  address     String            @db.VarChar(500)
  phone       String            @db.VarChar(20)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  admins      User[]
  services    Service[]
  products    Product[]
  bookings    Booking[]
  orders      Order[]
  slots       AppointmentSlot[]
}

model User {
  id               String    @id @default(cuid())
  name             String    @db.VarChar(100)
  email            String    @unique @db.VarChar(191)
  phone            String?   @db.VarChar(20)
  passwordHash     String    @db.VarChar(255)
  role             Role      @default(CUSTOMER)
  storeId          String?
  store            Store?    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  pets             Pet[]
  bookings         Booking[] @relation("CustomerBookings")
  assignedBookings Booking[] @relation("AssignedBookings")
  orders           Order[]
  posts            Post[]
  reviews          Review[]
  sessions         Session[]

  @@index([storeId])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key    String   @id @db.VarChar(191)
  count  Int      @default(1)
  window DateTime
}

model Pet {
  id                 String    @id @default(cuid())
  userId             String
  name               String    @db.VarChar(80)
  type               PetType
  breed              String?   @db.VarChar(100)
  birthDate          DateTime? @db.Date
  weight             Decimal?  @db.Decimal(6, 2)
  vaccinationHistory String?   @db.Text
  nextVaccinationAt  DateTime? @db.Date
  nextDewormingAt    DateTime? @db.Date
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookings           Booking[]

  @@index([userId, createdAt])
}

model Service {
  image ServiceImage?
  deletedAt DateTime?
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  id              String    @id @default(cuid())
  name            String    @db.VarChar(160)
  slug            String    @unique @db.VarChar(191)
  description     String    @db.Text
  process         Json
  price           Decimal   @db.Decimal(12, 0)
  durationMinutes Int
  category        String    @db.VarChar(80)
  icon            String    @default("bath") @db.VarChar(30)
  isActive        Boolean   @default(true)
  bookings        Booking[]
  reviews         Review[]

  @@index([storeId])
  @@index([isActive, category])
}

model ServiceImage {
  serviceId String @id
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  data Bytes @db.MediumBlob
  contentType String @db.VarChar(30)
}

model AppointmentSlot {
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  bookingDate DateTime  @db.Date
  timeSlot    String    @db.VarChar(5)
  capacity    Int       @default(3)
  bookings    Booking[]

  @@unique([storeId, bookingDate, timeSlot])
  @@index([storeId])
}

model Booking {
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  id           String          @id @default(cuid())
  userId       String
  petId        String
  serviceId    String
  staffId      String?
  slotId       String
  bookingDate  DateTime        @db.Date
  timeSlot     String          @db.VarChar(5)
  startMinutes Int
  endMinutes   Int
  status       BookingStatus   @default(PENDING)
  note         String?         @db.Text
  price        Decimal         @db.Decimal(12, 0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation("CustomerBookings", fields: [userId], references: [id], onDelete: Restrict)
  pet          Pet             @relation(fields: [petId], references: [id], onDelete: Restrict)
  service      Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff        User?           @relation("AssignedBookings", fields: [staffId], references: [id], onDelete: Restrict)
  slot         AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([bookingDate, timeSlot, status])
  @@index([userId, createdAt])
  @@index([staffId, bookingDate, status])
  @@index([petId, bookingDate, status])
}

model Product {
  deletedAt DateTime?
  storeId     String
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  id          String         @id @default(cuid())
  name        String         @db.VarChar(160)
  slug        String         @unique @db.VarChar(191)
  category    String         @db.VarChar(80)
  price       Decimal        @db.Decimal(12, 0)
  stock       Int            @default(0)
  description String         @db.Text
  isActive    Boolean        @default(true)
  color       String         @default("sage") @db.VarChar(20)
  createdAt   DateTime       @default(now())
  images      ProductImage[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@index([storeId])
  @@index([isActive, category])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String  @db.VarChar(500)
  alt       String  @db.VarChar(160)
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Order {
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  id            String        @id @default(cuid())
  userId        String
  totalAmount   Decimal       @db.Decimal(14, 0)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(COD)
  status        OrderStatus   @default(PENDING)
  recipientName String        @db.VarChar(100)
  phone         String        @db.VarChar(20)
  address       String        @db.VarChar(500)
  note          String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]

  @@index([storeId])
  @@index([userId, createdAt])
  @@index([status, paymentStatus])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 0)
  productName String  @db.VarChar(160)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
}

model Post {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(200)
  slug      String   @unique @db.VarChar(191)
  content   String   @db.LongText
  excerpt   String   @db.VarChar(500)
  category  String   @db.VarChar(80)
  authorId  String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([published, category, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  serviceId String?
  productId String?
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, serviceId])
  @@unique([userId, productId])
  @@index([serviceId, createdAt])
  @@index([productId, createdAt])
}

model StoreBanner {
  storeId String
  slot Int
  contentType String @db.VarChar(30)
  data Bytes @db.MediumBlob
  updatedAt DateTime @updatedAt
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, slot])
}

model StoreGalleryImage {
  id String @id @default(cuid())
  storeId String
  alt String @db.VarChar(160)
  data Bytes @db.MediumBlob
  contentType String @db.VarChar(30)
  createdAt DateTime @default(now())
  store Store @relation(fields:[storeId],references:[id],onDelete:Cascade)
  @@index([storeId,createdAt])
}
